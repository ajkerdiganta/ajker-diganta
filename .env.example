# Copy to .env for local development. All values here are placeholders, never production secrets.
# Generate a unique auth secret: openssl rand -base64 48
DATABASE_URL="postgresql://ajker_diganta_app:replace-me@localhost:5432/ajker_diganta_dev?schema=public"
# Production/staging release job only; do not inject this into the long-lived app process.
# MIGRATION_DATABASE_URL="postgresql://migration_role:replace-me@staging-db.example:5432/ajker_diganta?sslmode=require"
# Local Prisma migration-diff database; never production.
SHADOW_DATABASE_URL="postgresql://ajker_diganta_app:replace-me@localhost:5432/ajker_diganta_shadow?schema=public"
# Disposable integration database. Database name must end in _test.
TEST_DATABASE_URL="postgresql://ajker_diganta_app:replace-me@localhost:5432/ajker_diganta_test?schema=public"
DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT_MS="10000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"

BETTER_AUTH_SECRET="replace-with-output-from-openssl-rand-base64-48"
BETTER_AUTH_URL="http://localhost:3000"
ADDITIONAL_TRUSTED_ORIGINS=""
PUBLIC_SITE_URL="http://localhost:3000"

# Password reset email; configure a real verified sender/provider only outside local development.
RESEND_API_KEY=""
EMAIL_FROM="দৈনিক আজকের দিগন্ত <accounts@example.com>"
# true only creates email-outbox records; no sender worker is included in this MVP.
EMAIL_NOTIFICATIONS_ENABLED="false"

# Optional in local development. Supply all four R2 values to enable image uploads.
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public CDN/custom domain serving verified/ objects only; quarantine must remain private.
R2_PUBLIC_BASE_URL=""
MEDIA_MAX_BYTES="10485760"

# Required for scheduled publication in deployed environments; generate a unique random secret.
JOB_AUTH_SECRET=""
